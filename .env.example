# Copy to .env.local and fill in. Never commit real values. Values are empty on purpose.
# These are read at build time and end up in the browser, so they must not hold secrets.

# Address of the keeper read API, for example http://127.0.0.1:8080
NEXT_PUBLIC_KEEPER_URL=
# Network label, for example testnet or mainnet. Must match the passphrase below.
NEXT_PUBLIC_STELLAR_NETWORK=
# Testnet: "Test SDF Network ; September 2015". Mainnet: "Public Global Stellar Network ; September 2015".
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=
# Stellar RPC server used to build and send transactions.
NEXT_PUBLIC_STELLAR_RPC_URL=
# The deployed recurring contract (starts with C).
NEXT_PUBLIC_CONTRACT_ID=
